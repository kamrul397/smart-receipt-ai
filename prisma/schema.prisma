generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User Model for Authentication
model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String    // Hashed password (never plain text!)
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
}

// 2. Allowed Expense Categories
enum Category {
  FOOD_DINING
  TRAVEL_TRANSPORT
  OFFICE_SUPPLIES
  SOFTWARE_TECH
  UTILITIES
  HEALTHCARE
  ENTERTAINMENT
  OTHER
}

// 3. The Main Expense Record (Linked to User)
model Expense {
  id           String        @id @default(cuid())
  userId       String?       // Foreign key pointing to User
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantName String
  date         DateTime
  totalAmount  Float
  taxAmount    Float?        @default(0)
  currency     String        @default("USD")
  category     Category      @default(OTHER)
  receiptUrl   String?
  notes        String?
  items        ExpenseItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([date])
  @@index([category])
}

// 4. Individual Line Items (Linked to Expense)
model ExpenseItem {
  id        String   @id @default(cuid())
  expenseId String
  name      String
  price     Float
  quantity  Int      @default(1)
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}